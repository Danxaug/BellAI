# === App ===
APP_NAME=Bellia
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,https://bellia.ai

# === Groq ===
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama3-8b-8192
GROQ_TIMEOUT=30

# === DB ===
DATABASE_URL=sqlite+aiosqlite:///./bellia.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/bellia

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Seguridad ===
SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# === Rate limiting ===
RATE_LIMIT_ENABLED=true

# === Observabilidad ===
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# === WhatsApp ===
WHATSAPP_PHONE=573168331986